# Copy this file to .env.local and fill in the values (never commit .env.local).
# Both values are in Supabase dashboard → Project Settings → API Keys / Data API.

# e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# The publishable key (starts with sb_publishable_). Never put the secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
